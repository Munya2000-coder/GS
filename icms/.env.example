# ICMS environment configuration
# Copy to .env for local development.

# --- Database ---
# Dev: SQLite (zero-config). Prod: Azure Database for PostgreSQL Flexible Server.
DATABASE_URL="file:./dev.db"
# Example Postgres (set provider="postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://user:pass@host:5432/icms?schema=public&sslmode=require"

# --- Auth ---
# AUTH_MODE: "dev" (header/cookie role switcher) or "entra" (Azure AD / MSAL).
AUTH_MODE="dev"
# Entra ID (only used when AUTH_MODE=entra) — PRD §7.2
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# --- File storage adapter ---
# STORAGE_MODE: "local" (disk) or "azure-blob".
STORAGE_MODE="local"
STORAGE_LOCAL_DIR="./storage"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="icms-evidence"

# --- Alert adapter (email/Teams) ---
# ALERT_MODE: "log" (console/db only) or "graph" (Microsoft Graph API).
ALERT_MODE="log"
GRAPH_SENDER_ADDRESS="compliance@elmshealthsolutions.co.uk"

# --- App ---
NODE_ENV="development"
