{
  "name": "icms",
  "version": "1.0.0",
  "private": true,
  "description": "Immigration Compliance Management System (ICMS) for ELMS Health Solutions Ltd",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
