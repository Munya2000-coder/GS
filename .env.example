# Copy to .env and edit. Values shown are defaults or examples.

# Runtime environment: development | staging | production | test
ENVIRONMENT=development

# SQLAlchemy-compatible connection string.
# Postgres (production):  postgresql+psycopg://user:pass@host:5432/dbname
# SQLite (development):   sqlite:///./gs_capital.db
DATABASE_URL=sqlite:///./gs_capital.db

# MUST be set to a long random value in production. Used for signing and
# future JWT issuance. Rotate periodically.
SECRET_KEY=change-me-in-production

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# JSON array of origins allowed to call the API. Required if serving the
# SPA from a different origin than the API.
CORS_ORIGINS=["http://127.0.0.1:5173"]

# Emit OWASP-recommended security headers. Disable only if an upstream
# proxy already adds them.
ENABLE_SECURITY_HEADERS=true

# Global workflow toggle. In regulated production deployments this MUST be
# false so makers cannot approve their own capital calls, distributions,
# fee schedules, waterfall runs, etc.
ALLOW_SELF_APPROVAL=false

# Gunicorn tuning (used by the Docker image entrypoint)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60
